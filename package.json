{
  "name": "dsh-activity-heatmap",
  "version": "1.1.0",
  "description": "GitHub-style activity heatmap for DeepSeek Harness: daily usage counted from your local session logs, with square, round, and custom shapes, palettes, and calendar layouts.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "高本",
    "url": "https://sphinxgg.com"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "heatmap",
    "activity",
    "calendar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ja.md",
    "INSTALL.md",
    "AGENTS.md",
    "LICENSE",
    "docs/*.png",
    "docs/demo.html",
    "README.zh.md",
    "docs/author.jpg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4uthen7/dsh-activity-heatmap.git"
  },
  "homepage": "https://github.com/4uthen7/dsh-activity-heatmap#readme",
  "bugs": {
    "url": "https://github.com/4uthen7/dsh-activity-heatmap/issues"
  }
}
